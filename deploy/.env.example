# 서버의 /opt/backend-service/.env 로 복사한 뒤 값을 채운다. .env는 Git에 올리지 않는다.
# 값에 공백, 따옴표, $, # 를 넣지 않는다. 비밀번호는 openssl rand -hex 16 이 만든 32자를 쓴다.

IMAGE_TAG=latest
DOMAIN=api.example.com

MYSQL_DATABASE=backend_service
MYSQL_USER=backend_app
MYSQL_PASSWORD=change-me-app-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=관리자
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password